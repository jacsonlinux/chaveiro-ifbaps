# Example only. Do not put real secrets in this file.

PORT=3000
NODE_ENV=development
EXTERNAL_ENV_PATH=/etc/keychain-ifbaps/.env

RESERVATION_STORE=memory
RESERVATION_CACHE_TTL_MS=300000
RESERVATION_ABSENCE_CONFIRMATION_SYNCS=2
RESERVATION_SYNC_EVENT_RETENTION_DAYS=90
RESERVATION_SYNC_SCHEDULE_ENABLED=false
RESERVATION_SYNC_INTERVAL_MS=900000
RESERVATION_SYNC_BACKOFF_MIN_MS=60000
RESERVATION_SYNC_BACKOFF_MAX_MS=1800000
# Legacy compatibility only. The target rule blocks only during startsAt <= now < endsAt.
KEY_RESERVATION_BLOCK_MINUTES=0
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/keychain-ifbaps/keychain-ifbaps-firebase-adminsdk-fbsvc-9a18ddb436.json
FIRESTORE_RESERVATIONS_COLLECTION=reservations
FIRESTORE_SYNC_EVENTS_COLLECTION=reservation_sync_events
KEY_CATALOG_STORE=memory
FIRESTORE_ROOMS_COLLECTION=rooms
FIRESTORE_KEYS_COLLECTION=keys
FIRESTORE_KEY_ROOM_LINKS_COLLECTION=key_room_links
KEY_MOVEMENT_STORE=memory
FIRESTORE_KEY_MOVEMENTS_COLLECTION=key_movements
KEY_OCCURRENCE_STORE=memory
FIRESTORE_KEY_OCCURRENCES_COLLECTION=key_occurrences
USER_STORE=memory
FIRESTORE_USERS_COLLECTION=users

# Auth options: disabled, trusted-header, session, firebase.
# trusted-header is temporary for controlled development/reverse-proxy contexts
# when session mode is not enabled.
AUTH_MODE=firebase
AUTH_SESSION_COOKIE_NAME=keychain_session
AUTH_OAUTH_STATE_COOKIE_NAME=keychain_oauth_state
AUTH_SESSION_TTL_MS=28800000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Firebase Authentication allowlist. Keep this restricted to portaria users.
AUTH_ALLOWED_EMAILS=replace-with-authorized-email
AUTH_DEFAULT_ROLES=portaria
AUTH_ADMIN_IDENTIFIERS=replace-with-admin-identification-or-email
AUTH_PORTARIA_IDENTIFIERS=replace-with-portaria-identification-or-email
AUTH_SESSION_STORE=memory
FIRESTORE_AUTH_SESSIONS_COLLECTION=auth_sessions

# Public frontend return URL used after a successful SUAP OAuth login.
APP_FRONTEND_URL=http://localhost:4200/
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Production PWA example:
# APP_FRONTEND_URL=https://keychain-ifbaps.web.app/
# CORS_ALLOWED_ORIGINS=https://keychain-ifbaps.web.app

# OAuth/SUAP values belong only in the backend runtime.
SUAP_CLIENT_ID=replace-with-client-id
SUAP_CLIENT_SECRET=replace-with-client-secret
SUAP_REDIRECT_URI=http://localhost:3000/auth/suap/callback
SUAP_AUTHORIZE_URL=https://suap.ifba.edu.br/o/authorize/
SUAP_TOKEN_URL=https://suap.ifba.edu.br/o/token/
SUAP_ME_URL=https://suap.ifba.edu.br/api/eu/
# Existing deployments may use these aliases instead:
SUAP_OAUTH_AUTHORIZE_URL=https://suap.ifba.edu.br/o/authorize/
SUAP_OAUTH_TOKEN_URL=https://suap.ifba.edu.br/o/token/
SUAP_OAUTH_ME_URL=https://suap.ifba.edu.br/api/eu/
SUAP_OAUTH_SCOPE=

# Reservation provider options: local, api, web-readonly.
SUAP_RESERVATION_PROVIDER=local

# Enable only with an authorized institutional account and read-only scope.
SUAP_WEB_READONLY_ENABLED=false

# These names are documented for the external env file only.
SUAP_URL=https://suap.ifba.edu.br
SUAP_URL_LOGIN=https://suap.ifba.edu.br/accounts/login/
SUAP_USERNAME=replace-with-institutional-user
SUAP_PASSWD=replace-with-secret-password

# Read-only reservation report. This is the primary source because it returns
# every room matching campus, period, time range and status filters.
SUAP_RESERVATION_REPORT_URL=https://suap.ifba.edu.br/comum/sala/reservasala_relat/
SUAP_ROOMS_URL=https://suap.ifba.edu.br/admin/comum/sala/?agendavel__exact=1&all=&predio__uo=27
SUAP_RESERVATION_SYNC_WINDOW_DAYS=30
SUAP_RESERVATION_START_TIME=07:00
SUAP_RESERVATION_END_TIME=17:00
SUAP_RESERVATION_CAMPUS_ID=27
SUAP_RESERVATION_STATUS=deferida
SUAP_BROWSER_HEADLESS=true
SUAP_BROWSER_TIMEOUT_MS=30000
# Optional only for controlled room-detail diagnostics/mapping. Do not use this
# as a manual list of all rooms.
SUAP_RESERVATION_ROOM_URLS=
