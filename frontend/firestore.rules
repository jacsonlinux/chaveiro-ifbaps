rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function allowedEmail() {
      return signedIn() && request.auth.token.email == 'jacsonlinux@gmail.com';
    }

    function userProfileExists() {
      return allowedEmail() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return userProfileExists() && userProfile().data.roles.hasAny([role]);
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function canOperate() {
      return hasRole('portaria') || isAdmin();
    }

    match /users/{userId} {
      allow read: if allowedEmail() && (request.auth.uid == userId || isAdmin());
      allow create: if allowedEmail() &&
        request.auth.uid == userId &&
        request.resource.data.roles.hasOnly(['portaria']);
      allow update: if isAdmin() || (
        allowedEmail() &&
        request.auth.uid == userId &&
        request.resource.data.roles == resource.data.roles
      );
      allow delete: if false;
    }

    match /reservations/{reservationId} {
      allow read: if canOperate();
      allow write: if false;
    }

    match /reservation_sync_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /sync_status/{statusId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rooms/{roomId} {
      allow read: if canOperate();
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /keys/{keyId} {
      allow read: if canOperate();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        canOperate() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['baseStatus', 'updatedAt', 'updatedBy'])
      );
    }

    match /key_room_links/{linkId} {
      allow read: if canOperate();
      allow create, update, delete: if isAdmin();
    }

    match /key_movements/{movementId} {
      allow read: if canOperate();
      allow create: if canOperate() && request.resource.data.actorUid == request.auth.uid;
      allow update: if canOperate() && request.resource.data.returnedByUid == request.auth.uid;
      allow delete: if false;
    }

    match /key_occurrences/{occurrenceId} {
      allow read: if canOperate();
      allow create: if canOperate() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
