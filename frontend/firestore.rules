rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authEmail() {
      return request.auth.token.email.lower();
    }

    function signedIn() {
      return request.auth != null &&
        (exists(/databases/$(database)/documents/registered_emails/$(authEmail())) ||
         (request.auth.token.email_verified == true &&
          (authEmail().matches('.*@ifba\\.edu\\.br$') ||
           authEmail() == 'jacsonlinux@gmail.com')));
    }

    function isPortariaIdentity() {
      return signedIn() &&
        exists(/databases/$(database)/documents/registered_emails/$(authEmail())) &&
        get(/databases/$(database)/documents/registered_emails/$(authEmail())).data.role == 'portaria';
    }

    function isAdminIdentity() {
      return signedIn() && authEmail() == 'jacsonlinux@gmail.com';
    }

    function userProfileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return userProfileExists() && userProfile().data.roles.hasAny([role]);
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function canOperate() {
      return isPortariaIdentity() || hasRole('portaria') || isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        (request.resource.data.roles.hasOnly(['usuario']) ||
         (isPortariaIdentity() && request.resource.data.roles.hasOnly(['portaria'])) ||
         (isAdminIdentity() && request.resource.data.roles.hasOnly(['admin'])));
      allow update: if isAdmin() || (
        signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.roles == resource.data.roles &&
        (request.resource.data.personId == resource.data.personId ||
         resource.data.personId == null)
      );
      allow delete: if false;
    }

    match /registered_emails/{email} {
      allow read: if signedIn() &&
        (authEmail() == email || isAdmin());
      allow create, update: if isAdmin() &&
        request.resource.data.email == email &&
        request.resource.data.role in ['portaria', 'admin'] &&
        request.resource.data.email is string;
      allow delete: if isAdmin();
    }

    match /people/{personId} {
      allow read: if canOperate() ||
        (signedIn() && resource.data.email == authEmail()) ||
        (signedIn() && request.method == 'get' &&
         resource.data.email == null &&
         userProfileExists() && userProfile().data.personId == null);
      allow write: if false;
    }

    match /qr_tokens/{tokenId} {
      allow create: if signedIn() &&
        request.resource.data.id == tokenId &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.personId == userProfile().data.personId &&
        request.resource.data.personId is string &&
        request.resource.data.status == 'active' &&
        request.resource.data.generatedAt is string &&
        request.resource.data.expiresAt is string &&
        request.resource.data.usedAt == null &&
        request.resource.data.usedByUid == null &&
        request.resource.data.usedByEmail == null;
      allow read: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid || canOperate());
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if canOperate() &&
        resource.data.status == 'active' &&
        request.resource.data.status == 'used' &&
        request.resource.data.usedAt is string &&
        request.resource.data.usedByUid == request.auth.uid &&
        request.resource.data.usedByEmail is string &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'usedAt', 'usedByUid', 'usedByEmail'
        ]);
    }

    match /pin_requests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.id == requestId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.operation in ['set_pin', 'verify_pin'] &&
        request.resource.data.pin is string &&
        request.resource.data.createdAt is string &&
        ((request.resource.data.operation == 'set_pin' &&
          request.resource.data.personId == userProfile().data.personId &&
          request.resource.data.personId is string) ||
         (request.resource.data.operation == 'verify_pin' && canOperate()));
      allow read: if signedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    match /reservations/{reservationId} {
      allow read: if canOperate();
      allow write: if false;
    }

    match /occupancies/{occupancyId} {
      allow read: if canOperate();
      allow write: if false;
    }

    match /reservation_sync_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /sync_status/{statusId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /keys/{keyId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /key_room_links/{linkId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /key_movements/{movementId} {
      allow read: if canOperate();
      allow create: if canOperate() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.id == movementId &&
        request.resource.data.keyId is string &&
        request.resource.data.roomId is string &&
        request.resource.data.status == 'retirada' &&
        request.resource.data.origin == 'portaria' &&
        request.resource.data.responsibleName is string &&
        request.resource.data.checkedOutByName is string &&
        request.resource.data.checkedOutAt is string &&
        !request.resource.data.keys().hasAny([
          'returnedAt', 'returnedByName', 'returnedByIdentifier',
          'returnedByUid', 'returnNotes'
        ]);
      allow update: if canOperate() &&
        resource.data.status == 'retirada' &&
        request.resource.data.returnedByUid == request.auth.uid &&
        request.resource.data.status == 'devolvida' &&
        request.resource.data.returnedByName is string &&
        request.resource.data.returnedAt is string &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'returnedByName', 'returnedByIdentifier', 'returnedAt',
          'returnNotes', 'returnedByUid'
        ]);
      allow delete: if false;
    }

    match /key_public_status/{keyId} {
      allow read: if signedIn();
      allow create, update: if canOperate() &&
        request.resource.data.keyId == keyId &&
        request.resource.data.status in ['disponivel', 'retirada'] &&
        request.resource.data.updatedAt is string &&
        request.resource.data.actorUid == request.auth.uid;
      allow delete: if false;
    }

    match /key_locks/{keyId} {
      allow read: if canOperate();
      allow create: if canOperate() &&
        !exists(/databases/$(database)/documents/key_locks/$(keyId)) &&
        request.resource.data.keyId == keyId &&
        request.resource.data.movementId is string &&
        request.resource.data.checkedOutAt is string &&
        request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if canOperate();
    }

    match /key_occurrences/{occurrenceId} {
      allow read: if canOperate();
      allow create: if canOperate() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.id == occurrenceId &&
        request.resource.data.keyId is string &&
        request.resource.data.type is string &&
        request.resource.data.actorName is string &&
        request.resource.data.occurredAt is string &&
        (request.resource.data.type == 'ocorrencia' || isAdmin());
      allow update, delete: if false;
    }
  }
}
